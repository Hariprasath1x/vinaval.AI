# =============================================================================
# VinavalAI — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=VinavalAI
# Set to "production" on Render; keeps "development" locally
APP_ENV=development
# Set to false in production
DEBUG=true

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local development:
DATABASE_URL=sqlite+aiosqlite:///./vinavalai.db
# On Render (PostgreSQL via asyncpg):
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname

# -----------------------------------------------------------------------------
# Security  [SECRET — required on Render]
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
# Token lifetime in minutes (default = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# Firebase Admin SDK  [SECRET — required on Render]
# -----------------------------------------------------------------------------
# Path to the service-account JSON downloaded from:
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
#
# Local development: place the file in backend/ and keep this path
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# On Render: upload via Secret Files and set:
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase.json

# Firebase Web API Key (public client-side key — NOT the service account)
# Found in Firebase Console → Project Settings → General → Web API Key
# Used only for the server-side password-reset email flow.
FIREBASE_WEB_API_KEY=AIzaSy...your-firebase-web-api-key

# -----------------------------------------------------------------------------
# Groq  [SECRET — required on Render]
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_...your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Gemini  [SECRET — optional fallback; recommended on Render]
# -----------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# -----------------------------------------------------------------------------
# Groq Fallback LLM Config [secret — required only if you want a fallback]
# -----------------------------------------------------------------------------
# GROQ_API_KEY=
# GROQ_MODEL=llama3-70b-8192

# -----------------------------------------------------------------------------
# Vector Store  [REQUIRED ON RENDER]
# -----------------------------------------------------------------------------
# Production Render MUST use pinecone. Chroma is only for local dev.
VECTOR_STORE_PROVIDER=pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=vinavalai-rag
CHROMA_PERSIST_DIR=./chroma_db

# -----------------------------------------------------------------------------
# CORS — Frontend URL  [not secret — required on Render]
# -----------------------------------------------------------------------------
# Production: set to your custom domain (or Render static site URL)
FRONTEND_URL=https://vinaval.hariprasath.me
# Local development default:
# FRONTEND_URL=http://localhost:5173
