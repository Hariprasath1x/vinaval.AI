# =============================================================================
# VinavalAI — Root .gitignore
# =============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Python & Testing Caches
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
*.egg-info/
.eggs/

# Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Environment Variables & Secrets (CRITICAL)
.env
*.env
.env.local
.env.*.local
firebase-service-account.json
*firebase*.json
credentials.json
client_secret*.json

# Local Databases & Vector Stores
backend/chroma_db/
backend/chroma_data/
chroma_db/
chroma_data/
*.db
*.sqlite
*.sqlite3
backend/vinavalai.db

# Logs & Diagnostics
logs/
*.log
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / Frontend Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.vite/
frontend/.vite/

# IDE Caches (Keep .vscode/settings.json and pyrightconfig.json)
.idea/
*.swp
*.swo
*~
